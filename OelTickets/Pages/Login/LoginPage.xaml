<Page x:Class="OelTickets.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OelTickets.Pages"
      xmlns:viewModel="clr-namespace:OelTickets.Pages.Login"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Page.DataContext>
        <viewModel:LoginViewModel/>
    </Page.DataContext>

    <Grid>
        <StackPanel Margin="24" VerticalAlignment="Center">
            <TextBlock FontSize="24" TextAlignment="Center" Text="Home Scene" Margin="0,0,0,12"/>
            <Button Content="Go to Settings" Width="180" Command="{Binding LoginCommand}"/>
        </StackPanel>
    </Grid>
</Page>
